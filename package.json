    "@babel/plugin-transform-runtime": "^7.12.1",
    "@babel/preset-env": "^7.12.7",
    "@babel/runtime": "^7.12.5",
    "anchorme": "^3.0.8",
    "audio-buffer-utils": "^5.1.2",
    "audio-context": "^1.0.3",
    "babel-loader": "^8.2.1",
    "brfs": "^2.0.2",
    "bytebuffer": "^5.0.1",
    "css-loader": "^7.1.5",
    "dompurify": "^3.4.17",
    "drop-stream": "^1.0.0",
    "duplex-maker": "^1.0.0",
    "file-loader": "^6.2.0",
