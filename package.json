{
  "name": "mumble-web",
  "version": "0.5.1",
  "description": "An HTML5 Mumble client.",
  "scripts": {
    "build": "webpack && node -e \"const fs = require('fs'); if (!fs.existsSync('dist/config.local.js')) fs.copyFileSync('app/config.local.js', 'dist/config.local.js')\"",
    "watch": "webpack --watch",
    "prepare": "rm -rf dist && npm run build",
    "test": "node --test test/*.test.cjs",
    "postinstall": "patch-package"
  },
  "author": "Jonas Herzig <me@johni0702.de>",
  "license": "ISC",
  "repository": "johni0702/mumble-web",
  "homepage": "https://github.com/johni0702/mumble-web",
  "files": [
    "dist"
  ],
  "devDependencies": {
