# Address of the existing Mumble server, not the website.
MUMBLE_SERVER=host.docker.internal:64738
# Must match the external network attached to global-caddy.
CADDY_NETWORK=caddy-proxy

# Only username and server password in the connection dialog.
WEB_SIMPLE_LOGIN=true
# Public WEBSITE host/port (never the raw Mumble address).
# Empty = automatically use the address/port from the browser's URL.
WEB_ADDRESS=
WEB_PORT=
